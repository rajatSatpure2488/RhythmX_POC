{
  "emr": {
    "name": "DrChrono"
  },
  "defaults": {
    "base_url_config": "DRCHRONO_API_BASE",
    "headers": {
      "Authorization": "Bearer {token}",
      "Content-Type": "application/json",
      "X-DRC-API-Version": "{DRCHRONO_API_VERSION}"
    },
    "success_status_codes": [200, 201],
    "timeout_seconds": 20,
    "request_body": "json",
    "payload": {
      "source": "mapped_payload",
      "allow_extra_fields": true,
      "strip_empty": true,
      "validate_required": true,
      "required_fields": [],
      "optional_fields": [],
      "defaults": {},
      "field_sources": {}
    }
  },
  "lookups": {
    "existing_patient": {
      "api": "patients_search",
      "params": {
        "first_name": "payload.first_name",
        "last_name": "payload.last_name",
        "date_of_birth": "payload.date_of_birth"
      },
      "result_list_path": "results",
      "result_id_path": "id"
    },
    "default_office": {
      "api": "offices",
      "cache_by": ["token_suffix", "context.doctor_id"],
      "result_list_path": "results",
      "match": {
        "field": "doctor",
        "context": "doctor_id"
      },
      "result_id_path": "id",
      "result_secondary_path": "exam_rooms.0.index",
      "secondary_default": 1
    },
    "appointment_by_patient_date": {
      "api": "appointments_lookup",
      "params": {
        "patient": "context.patient_id",
        "date": "context.date"
      },
      "result_list_path": "results",
      "result_id_path": "id"
    },
    "appointment_detail": {
      "api": "appointment_get",
      "path_params": {
        "appointment_id": "context.appointment_id"
      }
    }
  },
  "apis": {
    "patients": {
      "method": "POST",
      "path": "patients",
      "aliases": ["patient", "Patient"],
      "payload": {
        "required_fields": ["first_name", "last_name", "date_of_birth", "gender"],
        "optional_fields": [
          "doctor",
          "email",
          "home_phone",
          "cell_phone",
          "address",
          "city",
          "state",
          "zip_code"
        ],
        "field_sources": {
          "doctor": ["$context.doctor_id"],
          "first_name": ["first_name", "given", "name.0.given.0"],
          "middle_name": ["middle_name", "name.0.given.1"],
          "last_name": ["last_name", "family", "name.0.family"],
          "suffix": ["suffix", "name_suffix", "name.0.suffix.0"],
          "date_of_birth": {"sources": ["date_of_birth", "birth_date", "birthDate", "dob"], "transform": "date"},
          "gender": {"sources": ["gender", "sex", "gender_administrative", "administrative_gender"], "transform": "gender"},
          "email": ["email"],
          "home_phone": ["home_phone", "phone"],
          "cell_phone": ["cell_phone", "mobile_phone"],
          "address": ["address", "address_street", "street", "address.0.line.0"],
          "city": ["city", "address_city", "address.0.city"],
          "state": ["state", "address_state_code", "address_state", "address.0.state"],
          "zip_code": ["zip_code", "zip", "address_postal_code", "address.0.postalCode"]
        }
      }
    },
    "patients_search": {
      "method": "GET",
      "path": "patients",
      "request_body": "none",
      "aliases": ["patient_search", "patients_lookup"],
      "payload": {
        "source": "query_params",
        "validate_required": false,
        "optional_fields": ["first_name", "last_name", "date_of_birth"],
        "field_sources": {
          "first_name": ["first_name"],
          "last_name": ["last_name"],
          "date_of_birth": ["date_of_birth"]
        }
      }
    },
    "appointments": {
      "method": "POST",
      "path": "appointments",
      "aliases": ["appointment", "appointments", "encounter", "encounters", "Appointment", "Encounter"],
      "payload": {
        "required_fields": ["doctor", "office", "patient", "scheduled_time", "duration", "exam_room"],
        "optional_fields": [
          "status",
          "reason",
          "notes",
          "allow_overlapping",
          "custom_fields"
        ],
        "defaults": {
          "duration": 30,
          "exam_room": 1,
          "allow_overlapping": true,
          "status": "Confirmed"
        },
        "field_sources": {
          "patient": ["$context.patient_id"],
          "doctor": ["$context.doctor_id"],
          "office": {"sources": ["office", "office_id", "location_id"], "transform": "int"},
          "exam_room": {"sources": ["exam_room", "room"], "transform": "int", "default": 1},
          "scheduled_time": {"sources": ["scheduled_time", "start_dt", "start", "date", "appointment_date", "encounter_date", "visit_date"], "transform": "datetime"},
          "duration": {"sources": ["duration_in_mins", "duration", "duration_minutes", "minutesDuration", "length_minutes"], "transform": "duration_minutes", "default": 30},
          "status": {"sources": ["status"], "transform": "appointment_status", "default": "Confirmed"},
          "reason": ["reason_name_full", "reason_full_name", "reason", "chief_complaint", "service_type", "appointment_type", "encounter_type", "class_display", "description"],
          "notes": ["notes", "appointment_notes", "clinical_notes", "comment"],
          "payment_profile": ["payment_profile"],
          "icd10_codes": ["icd10_codes", "primary_diagnosis_code"],
          "custom_fields": {
            "transform": "custom_fields",
            "mappings": [
              {"field_type": 11463, "sources": ["reason_name_short"]},
              {"field_type": 11465, "sources": ["description", "chief_complaint"]},
              {"field_type": 11466, "sources": ["comment", "clinical_notes", "clinical_note", "appointment_notes", "notes"]},
              {"field_type": 11472, "sources": ["service_type", "appointment_type", "encounter_type", "type", "type.0.coding.0.display"]},
              {"field_type": 11473, "sources": ["specialty", "practitioner.specialty", "provider.specialty"]},
              {"field_type": 11474, "sources": ["appointment_type", "encounter_type", "care_setting", "setting", "class_display", "class.text", "class"]},
              {"field_type": 11475, "sources": ["provider_name", "practitioner_name", "doctor_name", "practitioner.name.0"]},
              {"field_type": 11488, "sources": ["reason_code"]},
              {"field_type": 11489, "sources": ["reason_code_vocab"]}
            ]
          }
        }
      }
    },
